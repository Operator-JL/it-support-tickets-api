PORT=3000
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_DATABASE=
JWT_SECRET=sist_demo_secret_change_me
GOOGLE_CLIENT_ID=
# Optional: restrict Google login to a Google Workspace domain.
GOOGLE_ALLOWED_DOMAIN=
# Optional: comma-separated allowlist. When set, only these emails can use Google login.
GOOGLE_ALLOWED_EMAILS=
# Optional: comma-separated emails that become admin only when auto-created by Google.
GOOGLE_ADMIN_EMAILS=
GOOGLE_DEFAULT_ROLE=usuario
FRONTEND_URL=http://localhost:5173

# Resend email notifications
# Set EMAIL_ENABLED=true only when using a real Resend API key.
# EMAIL_TO can be one email address or multiple addresses separated by commas.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
